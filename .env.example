# Mandate Gateway — Environment Configuration (Template)
# Copy to .env for local development or production configuration.

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3001
NODE_ENV=development

# Allowed CORS Origins (comma-separated list of browser origins permitted to invoke the API)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173

# Frontend Public Base URL (optional, used for absolute callback URLs)
FRONTEND_URL=http://localhost:5173

# Gateway Session Secret (minimum 32 characters required in production for signed session cookies)
SESSION_SECRET=mandate-gateway-production-secure-entropy-32-chars-minimum!

# ==============================================================================
# DATABASE CONFIGURATION (POSTGRESQL)
# ==============================================================================
# Connection string to PostgreSQL instance (e.g. Supabase, Neon, AWS RDS, local Docker)
# Example: postgresql://postgres:postgres@localhost:5432/mandate_gateway
#
# NOTE: If DATABASE_URL is left unset or empty, the server automatically boots an
# embedded in-memory PostgreSQL engine (pg-mem) with identical SQL dialect, migrations,
# and seed data. This enables zero-dependency out-of-the-box local development and CI testing.
DATABASE_URL=

# ==============================================================================
# PAYPAL SANDBOX INTEGRATION
# ==============================================================================
# Valid modes: 'sandbox' | 'live'
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# If PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are omitted, the server operates in
# deterministic mock sandbox mode, simulating PayPal order issuance and capture.

# ==============================================================================
# RATE LIMITING & SECURITY DEFENSES
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60

# ==============================================================================
# FRONTEND CONFIGURATION (Vite / React Client)
# ==============================================================================
# Dual Mode Operation:
# 'api'  -> Frontend talks to the live Express/PostgreSQL backend via /api or VITE_API_BASE_URL.
# 'demo' -> Frontend executes purely in-browser using client-side mock storage (fallback).
VITE_APP_MODE=api

# Leave VITE_API_BASE_URL empty to use the Vite dev proxy (/api -> http://localhost:3001).
# In production, set to your deployed public backend API URL (e.g. https://api.mandategateway.com/api).
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
